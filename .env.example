# Copy to .env for local runs. Never commit the real .env.
# In production these live in GitHub > Settings > Secrets and variables > Actions.

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

GEMINI_API_KEY=
# Optional: change the model without touching code
# GEMINI_MODEL=gemini-3.8-flash   (if it's retired, Sara switches to the newest Flash model herself)

# Optional fallback if Gemini fails
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

GMAIL_USER=
GMAIL_APP_PASSWORD=
# EMAIL_TO=   (defaults to GMAIL_USER)
# DASHBOARD_URL=
